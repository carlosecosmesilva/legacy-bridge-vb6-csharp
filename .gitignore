# ====================================
# Project Specific Exclusions
# ====================================
# Keep important configuration templates
!appsettings.json
!appsettings.Development.json.template
!docker-compose.yml

# Keep database scripts (these should be versioned)
!Db/*.sql

# Keep VB6 project files (but not workspace)
!VB6/*.vbp
!VB6/*.frm
!VB6/*.bas
!VB6/*.cls